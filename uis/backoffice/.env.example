# HealthCore Backoffice — environment variables
#
# Copy this file to `.env.local` and adjust values as needed.
# None of these values are secrets; the API base URL is resolved at runtime.

# ── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the HealthCore Central API (services/api).
#
# Optional — if omitted, the app derives the URL automatically:
#   - GitHub Codespaces: uses the forwarded backend port (https://<workspace>-8000.app.github.dev)
#   - Local development: falls back to http://localhost:8000
#
# Set it explicitly to override auto-detection, e.g. for a deployed backend:
NEXT_PUBLIC_API_URL=http://localhost:8000