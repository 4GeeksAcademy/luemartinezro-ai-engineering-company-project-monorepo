# HealthCore Central API — Environment variables
# Copy this file to .env and adjust values for your local environment.
# Never commit the actual .env file to version control.

JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
TINYDB_PATH=./data/tinydb.json
CORS_ORIGINS=*

# ── Password Reset ──
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Resend (email delivery for password reset) ──
# Get your API key at https://resend.com
# The free tier allows up to 100 emails/day via the onboarding@resend.dev sender
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Frontend URL (for password reset links in emails) ──
# Set this to the public/base URL of the frontend application so that
# password reset emails contain correct links in any environment.
# Examples:
#   FRONTEND_URL=http://localhost:3001       (local development)
#   FRONTEND_URL=https://backoffice.healthcore.com (production)
# If not set, the API will attempt to derive the URL from the request.
# FRONTEND_URL=http://localhost:3001
